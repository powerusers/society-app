{
  "name": "society-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @gvs/web",
    "dev:api": "npm run dev --workspace @gvs/api",
    "build": "npm run build --workspace @gvs/web",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace @gvs/api",
    "seed": "npm run seed --workspace @gvs/api",
    "dev:s3": "npm run dev:s3 --workspace @gvs/api",
    "dev:mobile": "npm run start --workspace @gvs/mobile",
    "android": "npm run android --workspace @gvs/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}

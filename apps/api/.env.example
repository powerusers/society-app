# Copy to .env for local development. Never commit the real file.

# Postgres. On Railway, set this by reference — ${{Postgres.DATABASE_URL}} — so it
# tracks the database service instead of being a copy that goes stale on rotation.
# TLS is chosen from the hostname: private hosts (*.internal, localhost) connect in
# plain text because they refuse an SSL handshake; anything public gets TLS. Append
# ?sslmode=require or ?sslmode=disable to override.
DATABASE_URL=postgres://gvs:gvs@127.0.0.1:5432/gvs_dev

# Signs access tokens. Generate with: openssl rand -base64 48
# The server refuses to boot in production if this is left at a dev value.
JWT_SECRET=dev-only-secret-not-for-production

PORT=4000
NODE_ENV=development

# Access tokens are short-lived; refresh tokens are stored hashed and rotate on use.
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API. This is the origin of
# the PAGE doing the calling — the web app — not this API's own URL. Surrounding
# quotes and a trailing slash are stripped; the parsed list is logged at boot.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Gates first-time setup, which creates the society and its first administrator.
# Leave it unset and setup is refused outright: on a public URL an unguarded
# bootstrap hands admin rights to whoever reaches it first. Generate with:
#   openssl rand -base64 24
# Once a society exists the endpoint is closed permanently, token or not.
SETUP_TOKEN=

# Password given to every seeded demo account. Change it before seeding anywhere real.
SEED_PASSWORD=password123

# Seeding is not an upsert: against a database that already holds a society it
# TRUNCATEs every table. In production it refuses unless this is set to "wipe".
# SEED_CONFIRM=wipe

# ---------------------------------------------------------------- S3 (documents)
# The bucket must be PRIVATE: block all public access, no bucket policy granting
# anonymous reads. Every upload and download goes through a presigned URL issued
# by this API after an authorization check.
S3_BUCKET=gvs-documents
S3_REGION=ap-south-1

# Leave the credentials unset in production and attach an IAM role instead — the
# SDK's default provider chain will pick it up. The role needs exactly:
#   s3:PutObject, s3:GetObject, s3:DeleteObject, s3:HeadObject
# on arn:aws:s3:::<bucket>/societies/*  — nothing else, and not s3:ListBucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How long a presigned upload form and a download link stay valid, in seconds.
S3_UPLOAD_TTL_SECONDS=300
S3_DOWNLOAD_TTL_SECONDS=120

# The bucket needs a CORS rule, because the browser uploads to it directly.
# Without one the preflight fails and every upload dies before a byte moves.
# See the AWS snippet in apps/api/README.md.

# Only for pointing at a local S3-compatible server in development.
# `npm run dev:s3` starts one with the right CORS rule already applied.
# S3_ENDPOINT=http://127.0.0.1:9100
# S3_FORCE_PATH_STYLE=true
# S3_DEV_ORIGINS=http://localhost:3000

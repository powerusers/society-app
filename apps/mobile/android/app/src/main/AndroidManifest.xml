<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The gate pass and staff card scanners. Runtime permission on every
         version this app supports; requested when a scanner first opens, not at
         launch, so the guard is asked in the one place the answer makes sense. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The approval prompt buzzes: a guard is waiting at the gate and the
         phone may be in a pocket. Install-time permission, never prompted for. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wakes a locked phone into the approval screen, the way an incoming call
         does. Until Android 14 declaring this was enough; since 14 it is
         reserved for calling and alarm apps unless the user grants it by hand in
         Settings, and without it the gate request falls back to a heads-up
         notification. GateModule.canUseFullScreenIntent() reports which. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Holds the device awake long enough to draw the approval screen after the
         full-screen intent turns the display on. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13 and up. Notifications are refused by default until the user
         is asked, and asking is a runtime prompt — see src/lib/push.js. Older
         releases grant it at install time and ignore this line. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!-- The channel a notification lands in when FCM delivers one while the
           app is not running. Without this Android drops the notification on
           13+, because a message that names no channel has nowhere to go. The
           app creates the "gate" channel itself at startup; this is the
           fallback for anything that arrives before that has happened. -->
      <!-- react-native-firebase_messaging declares both of these with empty
           values, so the merger needs telling which one wins. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="gate_v2"
        tools:replace="android:value" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/ic_launcher_background"
        tools:replace="android:resource" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        The gate approval screen.

        Its own task, so answering the gate from the lock screen does not shuffle
        the main app's back stack or leave Prangan open afterwards. excludeFromRecents
        keeps a one-question screen out of the recents list, and showOnLockScreen
        lets the full-screen intent draw it without the phone being unlocked.

        Not exported: only this app's own full-screen intent may start it.
      -->
      <activity
        android:name=".GateApprovalActivity"
        android:exported="false"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:launchMode="singleInstance"
        android:taskAffinity=".gate"
        android:excludeFromRecents="true"
        android:showOnLockScreen="true"
        android:turnScreenOn="true"
        android:showWhenLocked="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:windowSoftInputMode="adjustResize" />

      <!--
        Receives push messages.

        Replaces Firebase's default handling so a gate request can carry a
        full-screen intent. The API sends those as data-only messages precisely
        so this runs — a message with a `notification` block is drawn by the
        system before any of our code gets a say.
      -->
      <!--
        Android delivers a MESSAGING_EVENT to one service only. PranganMessagingService
        extends the library's and calls super, so removing this registration keeps
        JavaScript delivery working while making the winner unambiguous — rather
        than leaving two candidates and depending on merge order.
      -->
      <service
        android:name="io.invertase.firebase.messaging.ReactNativeFirebaseMessagingService"
        tools:node="remove" />

      <service
        android:name=".PranganMessagingService"
        android:exported="false"
        android:directBootAware="false">
        <intent-filter>
          <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
      </service>
    </application>
</manifest>
